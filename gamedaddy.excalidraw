      "isDeleted": false,
      "boundElements": null,
      "updated": 1776290233443,
      "link": null,
      "locked": false,
      "text": "void write_rtc_register_(uint8_t val) {\n    switch (rtc_selected_) {\n        case 0x08: rtc_.seconds = val % 60; break;\n        case 0x09: rtc_.minutes = val % 60; break;\n        case 0x0A: rtc_.hours   = val % 24; break;\n        case 0x0B: rtc_.day_low = val; break;\n        case 0x0C: rtc_.day_high = val & 0xC1; break;\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void write_rtc_register_(uint8_t val) {\n    switch (rtc_selected_) {\n        case 0x08: rtc_.seconds = val % 60; break;\n        case 0x09: rtc_.minutes = val % 60; break;\n        case 0x0A: rtc_.hours   = val % 24; break;\n        case 0x0B: rtc_.day_low = val; break;\n        case 0x0C: rtc_.day_high = val & 0xC1; break;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
