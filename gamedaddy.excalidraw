    {
      "id": "90C2_-8CwzBdBZZ7KsCV1",
      "type": "text",
      "x": -313.4122713957553,
      "y": 1441.7172849599383,
      "width": 461.9596862792969,
      "height": 550,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
