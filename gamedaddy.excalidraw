      "updated": 1776288028582,
      "link": null,
      "locked": false,
      "text": "   MBC3\n    \" simple banking + RTC\"\n\n        - uint8 rtc_selected_    (which curr reg)\n        - uint8 last_latch_write_ = 0\n        - RTC rtc_\n\n        - uint8 rom_bank_ (1-127, or 7 bits)\n        - uint8 ram_bank_ (2 bits)\n        - bool ram_rtc_enabled_\n\n        - rom_bank_count\n        - ram_bank_count\n\n     -----------------------------------------------\n        + read8(addr) override*\n        + write8(addr, val) override*\n\n        - read_rtc_register()\n        - write_rtc_register_(value)\n        - latch_clock()\n        - clamp_rom_bank **\n        - clamp_ram_bank **\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "5-VsM0Ncc2bcV-wDHOasg",
      "originalText": "   MBC3\n    \" simple banking + RTC\"\n\n        - uint8 rtc_selected_    (which curr reg)\n        - uint8 last_latch_write_ = 0\n        - RTC rtc_\n\n        - uint8 rom_bank_ (1-127, or 7 bits)\n        - uint8 ram_bank_ (2 bits)\n        - bool ram_rtc_enabled_\n\n        - rom_bank_count\n        - ram_bank_count\n\n     -----------------------------------------------\n        + read8(addr) override*\n        + write8(addr, val) override*\n\n        - read_rtc_register()\n        - write_rtc_register_(value)\n        - latch_clock()\n        - clamp_rom_bank **\n        - clamp_ram_bank **\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IczDKLoHMxHZ7GoOJOCdb",
      "type": "arrow",
