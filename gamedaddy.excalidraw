      "updated": 1776287910252,
      "link": null,
      "locked": false,
      "text": "    RomOnly\n       -----------------------------------------------\n        + read8(addr) override*\n        + write8(addr, val) override (does nothing)\n\n* added security to ensure we take the abstract\nclass' methods and not create a new method\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "gFMF9u6D-DL7-PSLLKjBn",
      "originalText": "    RomOnly\n       -----------------------------------------------\n        + read8(addr) override*\n        + write8(addr, val) override (does nothing)\n\n* added security to ensure we take the abstract class' methods and not create a new method\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RBsgo0WYPHblUQDriuHcx",
      "type": "text",
      "x": -572.3164867245907,
      "y": 3226.8944222893033,
      "width": 464.39156525036134,
      "height": 69.00879571095085,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
