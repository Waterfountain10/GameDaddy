      "seed": 1446754288,
      "version": 530,
      "versionNonce": 504293746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776287910252,
      "link": null,
      "locked": false,
      "text": "- if addr is 0x0000-0x7FFF (directly to rom)\n- if addr is 0xA000-0xBFFF (optional ram)\n- writes do nothing",
      "fontSize": 18.402345522920225,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- if addr is 0x0000-0x7FFF (directly to rom)\n- if addr is 0xA000-0xBFFF (optional ram)\n- writes do nothing",
      "autoResize": false,
      "lineHeight": 1.25
    },
