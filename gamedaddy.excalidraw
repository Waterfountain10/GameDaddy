    {
      "id": "PX1HMhNsZlhkOPPM_532T",
      "type": "text",
      "x": 660.3864233686401,
      "y": 1233.8483960134108,
      "width": 628.2574462890625,
      "height": 799.5291388002717,
      "angle": 0,
