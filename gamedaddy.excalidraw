    {
      "id": "8lGZxngsXFKc57MOKfWAA",
      "type": "text",
      "x": 2116.474994515832,
      "y": 1116.9223587418132,
      "width": 438.959716796875,
      "height": 500.1924812013223,
      "angle": 0,
