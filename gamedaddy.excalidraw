      "updated": 1776294940472,
      "link": null,
      "locked": false,
      "text": "INTERRUPT_VEC\n(type) |-> addr:\n\n0:VBlank  → 0x40\n1:LCD     → 0x48\n2:Timer   → 0x50\n3:Serial  → 0x58\n4:Joypad  → 0x60\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "FGz6h5m7Gb1dloWh70L6x",
      "originalText": "INTERRUPT_VEC (type) |-> addr:\n\n0:VBlank  → 0x40\n1:LCD     → 0x48\n2:Timer   → 0x50\n3:Serial  → 0x58\n4:Joypad  → 0x60\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
