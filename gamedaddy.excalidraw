      "text": "The CPU will\nservice an\ninterrupt if:\n\nIME == 1\nAND\n(IE & IF) != 0",
      "fontSize": 20.9347069932532,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The CPU will service an interrupt if:\n\nIME == 1\nAND\n(IE & IF) != 0",
      "autoResize": false,
      "lineHeight": 1.25
    },
