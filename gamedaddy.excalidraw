      "boundElements": null,
      "updated": 1776288437897,
      "link": null,
      "locked": false,
      "text": "RTC\n\nstruct RTC {\n    uint8_t seconds = 0;      // 0x08\n    uint8_t minutes = 0;      // 0x09\n    uint8_t hours = 0;        // 0x0A\n    uint8_t day_low = 0;      // 0x0B\n    uint8_t day_high = 0;     // 0x0C\n\n    uint8_t latched_seconds = 0;\n    uint8_t latched_minutes = 0;\n    uint8_t latched_hours = 0;\n    uint8_t latched_day_low = 0;\n    uint8_t latched_day_high = 0;\n};\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "SrTfRtfEYnhXOw9G4W2d4",
      "originalText": "RTC\n\nstruct RTC {\n    uint8_t seconds = 0;      // 0x08\n    uint8_t minutes = 0;      // 0x09\n    uint8_t hours = 0;        // 0x0A\n    uint8_t day_low = 0;      // 0x0B\n    uint8_t day_high = 0;     // 0x0C\n\n    uint8_t latched_seconds = 0;\n    uint8_t latched_minutes = 0;\n    uint8_t latched_hours = 0;\n    uint8_t latched_day_low = 0;\n    uint8_t latched_day_high = 0;\n};\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
